<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>iDeviceInfo</AssemblyName>
    <RootNamespace>iDeviceInfo</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Require admin so AMDevicePair() can write to C:\ProgramData\Apple\Lockdown\ -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\iDeviceInfo.ico</ApplicationIcon>

    <!-- Single-file self-contained exe for distribution -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Version info shown in exe properties -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ProductName>iDeviceInfo</ProductName>
    <Company>iDeviceInfo</Company>
    <Description>iOS device info reader - reads Serial, IMEI, Battery Health from connected devices</Description>
    <Copyright>2025</Copyright>
  </PropertyGroup>


  <ItemGroup>
    <Content Include="Resources\iDeviceInfo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Color database: embedded as fallback AND copied next to the exe so it
         can be replaced when new devices launch (exe copy wins if present). -->
    <EmbeddedResource Include="apple_device_colors.json" LogicalName="iDeviceInfo.apple_device_colors.json" />
    <Content Include="apple_device_colors.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
